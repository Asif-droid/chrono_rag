  "dataset": {
    "name": "BankEase Temporal Requirements Dataset",
    "version": "1.0",
    "description": "Synthetic requirements messages and ground-truth temporal events for testing a temporal RAG pipeline.",
    "timezone": "UTC",
    "date_format": "YYYY-MM-DD",
    "reference_date": "2026-04-20",
    "notes": [
      "All stakeholders, messages, and requirements are fictional.",
      "A proposed requirement is not an approved state change.",
      "stated_at is when the requirement was communicated; effective_at is when it becomes effective.",
      "For historical-state queries, evaluate approved requirements effective on or before the requested date.",
      "The dataset uses explicit supersedes links for approved changes and cancellation/restoration events."
    ]
  },
